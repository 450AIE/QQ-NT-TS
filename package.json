{
    "name": "qq-nt-ts",
    "version": "0.2.0",
    "description": "An Electron application with Vue and TypeScript",
    "main": "./out/main/index.js",
    "author": "LY and LX",
    "homepage": "https://electron-vite.org",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts,.vue --fix",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "start": "electron-vite preview",
        "dev": "chcp 65001 && electron-vite dev",
        "strict-build": "npm run typecheck && electron-vite build",
        "build": "electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win",
        "build:mac": "npm run build && electron-builder --mac",
        "build:linux": "npm run build && electron-builder --linux",
        "prepare": "husky & node scripts/rebuild_better_sqlite3.js",
        "lint-staged": "lint-staged"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.0",
        "@electron-toolkit/utils": "^3.0.0",
        "@element-plus/icons-vue": "^2.3.1",
        "@types/lodash-es": "^4.17.12",
        "@vueuse/core": "^13.0.0",
        "@wangeditor/editor-for-vue": "^5.1.12",
        "axios": "^1.8.1",
        "better-sqlite3": "^11.9.1",
        "dompurify": "^3.2.5",
        "electron-updater": "^6.1.7",
        "element-plus": "^2.8.4",
        "hash-wasm": "^4.12.0",
        "lodash-es": "^4.17.21",
        "long": "^5.3.1",
        "pinia": "^2.2.4",
        "protobufjs": "^7.4.0",
        "systeminformation": "^5.25.11",
        "vue-router": "^4.4.5"
    },
    "devDependencies": {
        "@commitlint/config-conventional": "^19.8.0",
        "@electron-toolkit/eslint-config": "^1.0.2",
        "@electron-toolkit/eslint-config-ts": "^2.0.0",
        "@electron-toolkit/tsconfig": "^1.0.1",
        "@rushstack/eslint-patch": "^1.10.3",
        "@types/node": "^20.14.8",
        "@vitejs/plugin-vue": "^5.0.5",
        "@vue/eslint-config-prettier": "^9.0.0",
        "@vue/eslint-config-typescript": "^13.0.0",
        "commitlint": "^19.8.0",
        "electron-builder": "^24.13.3",
        "electron-rebuild": "^3.2.9",
        "electron-vite": "^3.0.0",
        "eslint": "^8.57.0",
        "eslint-plugin-vue": "^9.26.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.0",
        "prettier": "^3.3.2",
        "rollup-plugin-visualizer": "^5.14.0",
        "typescript": "^5.5.2",
        "unplugin-auto-import": "^0.18.3",
        "unplugin-vue-components": "^0.27.4",
        "vite": "^5.3.1",
        "vite-plugin-imagemin": "^0.6.1",
        "vite-plugin-mkcert": "^1.17.8",
        "vite-plugin-proto": "^1.0.0",
        "vite-plugin-purgecss": "^0.2.13",
        "vite-plugin-static-copy": "^2.3.0",
        "vue": "^3.4.30",
        "vue-tsc": "^2.0.22"
    },
    "husky": {
        "hooks": {
            "pre-commit": "pnpm run lint-staged",
            "commit-msg": "pnpm run commitlint -E HUSKY_GIT_PARAMS"
        }
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx,vue}": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
